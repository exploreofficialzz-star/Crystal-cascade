<resources>
<!--  FIX: @android:style/Theme.Light.NoActionBar was removed in SDK 35.
         Use Theme.AppCompat.Light.NoActionBar from the AppCompat library instead.
         Requires androidx.appcompat:appcompat in build.gradle dependencies.  -->
<style name="LaunchTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
<item name="android:windowBackground">@drawable/launch_background</item>
<item name="android:windowFullscreen">true</item>
</style>
<style name="NormalTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
<item name="android:windowBackground">?android:colorBackground</item>
</style>
</resources>
