; Crystal Cascade — Godot 4.6 3D Edition
config_version=5

[application]
config/name="Crystal Cascade"
config/description="Sort coloured crystals in 3D to clear the board."
config/version="2.5.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/images/game_logo.png"
boot_splash/image="res://assets/images/game_logo.png"
boot_splash/bg_color=Color(0.035, 0.04, 0.1, 1)

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
; canvas_items scales every pixel — correct for a 2D/3D hybrid game
window/stretch/mode="canvas_items"
; expand fills taller Android screens (20:9, 21:9) without black bars
window/stretch/aspect="expand"
; Force portrait — prevents landscape rendering on device rotation
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60

[gui]
theme/default_font_multichannel_signed_distance_field=true

[input]
touch_select={"deadzone": 0.5, "events": [Object(InputEventScreenTouch,"pressed":true)]}

audio/driver/enable_input=false
