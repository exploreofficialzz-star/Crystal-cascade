; Crystal Cascade — Godot 4 3D Edition
; Full gameplay migration from the Flutter reference project.
config_version=5

[application]
config/name="Crystal Cascade"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/version="2.5.0"
boot_splash/image="res://assets/images/game_logo.png"
boot_splash/bg_color=Color(0.035, 0.04, 0.1, 1)

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

audio/driver/enable_input=false

[input]
touch_select={"deadzone": 0.5, "events": [Object(InputEventScreenTouch,"pressed":true)]}

[gui]
theme/default_font_multichannel_signed_distance_field=true
