# Copy this file to .env for local testing. Never commit the real .env —
# it should already be covered by a `.env` line in .gitignore; add one if not.
#
# Get this from your Paystack Dashboard → Settings → API Keys & Webhooks.
# Use the SECRET key (starts with sk_test_ or sk_live_) — never the public
# key here, and never put this value inside the Flutter app.
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

PORT=3000
